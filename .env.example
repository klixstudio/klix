# Claude API key. Without it Klix runs in test mode.
ANTHROPIC_API_KEY=
# Optional: raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# New Claude scripts per visitor IP per day, and in total per day.
SCRIPTS_PER_IP_PER_DAY=5
CLAUDE_CALLS_PER_DAY=150
PORT=8787
# Set to 1 when running the Node server behind a proxy.
# TRUST_PROXY=1
# Optional HTTPS port for testing on a phone over Wi-Fi (self-signed cert in data/).
# LAN_HTTPS_PORT=8443
